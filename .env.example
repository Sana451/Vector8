# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=**************
FIRST_SUPERUSER=**************
FIRST_SUPERUSER_PASSWORD=**************

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=**************
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app"

# Frontend - Maps
VITE_TOMTOM_API_KEY=**************

# Routing (TomTom)
ROUTING_PROVIDER=tomtom
TOMTOM_API_KEY=**************
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_API_VERSION=3
TOMTOM_TIMEOUT_SECONDS=30
