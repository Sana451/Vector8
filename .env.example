FASTAPI_ENV=development

PROJECT_NAME="Vector8"

SECRET_KEY=**************
FIRST_SUPERUSER=**************
FIRST_SUPERUSER_PASSWORD=**************

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=**************
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app"
TEST_DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app_test"

# Frontend - Maps
VITE_TOMTOM_API_KEY=**************

# Map layer providers (one vendor may serve several domains)
GEOCODING_PROVIDER=tomtom
ROUTING_PROVIDER=tomtom
TRAFFIC_PROVIDER=off
FUEL_PROVIDER=off
TRUCK_RESTRICTION_PROVIDER=internal
REST_AREAS_PROVIDER=here

# TomTom (routing + traffic)
TOMTOM_API_KEY=**************
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_API_VERSION=3
TOMTOM_TIMEOUT_SECONDS=30

# HERE (rest areas + fuel search along route, backend only)
HERE_API_KEY=**************
HERE_BASE_URL=https://browse.search.hereapi.com
HERE_TIMEOUT_SECONDS=30
HERE_POI_CORRIDOR_WIDTH_METERS=1000
HERE_POI_LIMIT=100
HERE_POI_CACHE_TTL_SECONDS=86400
HERE_POI_USE_EXCURSION_DISTANCE_RANKING=false
HERE_FUEL_BASE_URL=https://fuel.hereapi.com
HERE_FUEL_CORRIDOR_WIDTH=1000
HERE_FUEL_LIMIT=1000

# Internal fuel station API (used only when FUEL_PROVIDER=internal; ignored for here/off)
FUEL_API_BASE_URL=
FUEL_API_KEY=
FUEL_API_TIMEOUT_SECONDS=15

# Internal truck restriction API (layer degrades gracefully when unset)
TRUCK_RESTRICTION_API_BASE_URL=
TRUCK_RESTRICTION_API_KEY=
TRUCK_RESTRICTION_API_TIMEOUT_SECONDS=15

# Per-domain cache TTLs (lazy invalidation on read)
GEOCODING_CACHE_TTL_SECONDS=2592000
ROUTE_CALCULATION_CACHE_TTL_SECONDS=3600
TRAFFIC_CACHE_TTL_SECONDS=120
FUEL_CACHE_TTL_SECONDS=86400
TRUCK_RESTRICTION_CACHE_TTL_SECONDS=604800

# Map overview defaults
MAP_LAYER_RADIUS_METERS=5000
MAP_LAYER_RESULT_LIMIT=5000
